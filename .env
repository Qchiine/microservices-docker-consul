# Ports par defaut = ceux de l'enonce du TP 25.
# Pour eviter un conflit avec un autre projet deja lance :
#   cp .env.example .env.local && docker compose --env-file .env.local up -d --build
MYSQL_PORT=3306
CONSUL_PORT=8500
CONSUL_DNS_PORT=8600
GATEWAY_PORT=8888
CLIENT_PORT=8088
VOITURE_PORT=8089
PHPMYADMIN_PORT=8081
